# Copia este archivo a .env y ajusta los valores. .env NUNCA se sube a git.

# Generar una llave nueva para producción (no reutilizar la de desarrollo):
#   docker compose run --rm web python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=cambia-esto-por-una-llave-generada

# Desarrollo: True. En la PC servidor de la oficina: False.
# Con True, Django muestra la traza completa del error a quien abra la página
# — incluidas rutas y configuración. Nunca dejarlo en True en producción.
DJANGO_DEBUG=True

# Desde qué direcciones se acepta entrar.
#   Desarrollo:  *
#   Producción:  la IP fija de la PC servidor, p. ej. 192.168.1.17,localhost
# Con DEBUG=False, Django rechaza cualquier host que no esté en esta lista.
DJANGO_ALLOWED_HOSTS=*

POSTGRES_DB=bodega
POSTGRES_USER=bodega_user
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Solo para crear el primer superusuario administrador al levantar el proyecto.
# Después de crearlo conviene cambiarle la contraseña con:
#   docker compose exec web python manage.py cambiar_clave admin --generar
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=cambia-esta-contrasena
DJANGO_SUPERUSER_EMAIL=admin@solucionesexactas.local
